import java.util.Scanner;
public class KarthiMart {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int choice;
        do {
            System.out.println("\n===== KARTHIMART =====");
            System.out.println("1. User Registration");
            System.out.println("2. User Login");
            System.out.println("3. Admin Login");
            System.out.println("4. Exit");
            System.out.print("Enter your choice: ");
            choice = sc.nextInt();
            switch (choice) {
                case 1:
                    System.out.println("User Registration Selected");
                    break;
                case 2:
                    System.out.println("User Login Selected");
                    break;
                case 3:
                    System.out.println("Admin Login Selected");
                    break;

                case 4:
                    System.out.println("Thank you for visiting KarthiMart!");
                    break;
                default:
                    System.out.println("Invalid choice!");
            }
        } while (choice != 4);
        sc.close();
    }
}
